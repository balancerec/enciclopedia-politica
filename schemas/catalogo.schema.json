{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catálogo de conceitos",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "updated_at",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nome",
          "tipo",
          "familias",
          "volume_principal",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "nome": {
            "type": "string",
            "minLength": 2
          },
          "tipo": {
            "enum": [
              "regime",
              "forma_governo",
              "sistema_economico",
              "teoria_economica",
              "teoria_politica",
              "movimento",
              "politica_publica",
              "doutrina_politico_religiosa",
              "rotulo_analitico",
              "ideologia",
              "vertente"
            ]
          },
          "familias": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^F(0[1-9]|1[0-2])$"
            }
          },
          "volume_principal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "status": {
            "enum": [
              "planejado",
              "rascunho",
              "em_revisao",
              "publicado",
              "desatualizado"
            ]
          },
          "observacao": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "nota": {
            "type": "string",
            "pattern": "^verbetes/(?:ideologias|conceitos)/[a-z0-9-]+\\.md$"
          }
        }
      }
    }
  }
}
